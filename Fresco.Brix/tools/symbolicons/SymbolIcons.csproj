<Project Sdk="Microsoft.NET.Sdk">

  <!-- SymbolIcons - a REPO TOOL. It ships nothing: it engraves Frescobaldi's
       symbol sources with LilyPort and writes the resulting SVGs into
       src/Fresco.Brix.Core/assets/symbols/, which the application does ship.
       It is deliberately NOT in Fresco.Brix.slnx: it is run by hand when the
       icons need regenerating, and a normal build must not depend on it.
       (Lily.Docs precedent.) -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fresco.Brix.Tools.SymbolIcons</RootNamespace>
    <AssemblyName>SymbolIcons</AssemblyName>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The engine, as the PUBLISHED package — the same pin the application
       carries in src/Fresco.Brix.Core/Fresco.Brix.Core.csproj, so the icons are
       always engraved by the engine the application ships with. ONE reference
       is the whole engine: the facade bundles Engine, Backends, Parsing and
       Flower inside itself with PrivateAssets="all" and depends on
       CodeBrix.LilyScheme.LgplLicenseForever from nuget.org.
       //was previously: four ProjectReferences into
       ..\..\..\CodeBrix.LilyPort\src\... — CodeBrix.LilyPort moved to its own
       repository on 2026-08-27 and those relative paths went with it (board
       row W13b). -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.LilyPort.GplLicenseForever" Version="1.0.244.98" />
  </ItemGroup>

</Project>

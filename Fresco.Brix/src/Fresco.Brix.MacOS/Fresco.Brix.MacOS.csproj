<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Temporary local platform preview, built in the sibling Platform repo.
         These properties affect this macOS head only. -->
    <MacOSPlatformPreviewVersion Condition="'$(MacOSPlatformPreviewVersion)' == ''">1.0.273.1-macosmenu.4</MacOSPlatformPreviewVersion>
    <MacOSPlatformPreviewFeed Condition="'$(MacOSPlatformPreviewFeed)' == ''">$(MSBuildThisFileDirectory)../../../../CodeBrix.Platform/nugets/MacOSPreview</MacOSPlatformPreviewFeed>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MacOSPlatformPreviewFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views) -->
  <Import Project="..\Fresco.Brix.UI\Fresco.Brix.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\Fresco.Brix.Core\Fresco.Brix.Core.csproj" />
  </ItemGroup>

  <!-- EXACTLY ONE platform head package; all other packages come from Fresco.Brix.Core -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.MacOS.ApacheLicenseForever" Version="$(MacOSPlatformPreviewVersion)" />
  </ItemGroup>
</Project>

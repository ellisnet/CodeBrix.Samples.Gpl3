<Page
    x:Class="Fresco.Brix.Views.MainPage"
    xmlns="clr-namespace:Microsoft.UI.Xaml.Controls;assembly=CodeBrix.Platform.UI"
    xmlns:d="clr-namespace:Microsoft.UI.Xaml.Data;assembly=CodeBrix.Platform.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Fresco.Brix.ViewModels;assembly=Fresco.Brix.Core"
    xmlns:local="using:Fresco.Brix.Views"
    FontFamily="{StaticResource RobotoFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- The menu bar -->
            <RowDefinition Height="Auto" />
            <!-- The two window toolbars, side by side on one row -->
            <RowDefinition Height="Auto" />
            <!-- The document tabs -->
            <RowDefinition Height="Auto" />
            <!-- The dock shell: tool panels around the editor area -->
            <RowDefinition Height="*" />
            <!-- The status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar x:Name="MainMenuBar" Grid.Row="0" />

        <!-- The Main Toolbar and the Music View Toolbar (board wave W14,
             ruling FR16), side by side in one tray from the CommandBar add-in.
             Built in code for the same reason the shell and the tab bar are:
             the buttons follow the command objects, their icons are the
             shipped SVG sets drawn at the window's own theme, and three of
             them carry pull-down menus. -->
        <ContentControl x:Name="ToolbarHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" />

        <!-- The tab bar and the shell are built in code: the working area is
             two nested CodeBrix.Platform pane controls whose panes are filled
             once and then opened and shut as the panels come and go (a pane
             control offers three regions and this window needs four, and it is
             the shell that keeps that bookkeeping), and the tabs follow the
             document list rather than an items source. -->
        <ContentControl x:Name="TabBarHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch" />

        <ContentControl x:Name="ShellHost" Grid.Row="3"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- The window's message line. The caret position lives on each
             editor pane's own status bar, as it does upstream, so this stays
             out of the way until there is something to say. -->
        <TextBlock x:Name="StatusLine" Grid.Row="4" Padding="8,4,8,6"
                   Visibility="Collapsed"
                   Text="{d:Binding StatusText}" />
    </Grid>
</Page>

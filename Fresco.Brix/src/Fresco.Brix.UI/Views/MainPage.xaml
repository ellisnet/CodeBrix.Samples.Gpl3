<Page
    x:Class="Fresco.Brix.Views.MainPage"
    xmlns="clr-namespace:Microsoft.UI.Xaml.Controls;assembly=CodeBrix.Platform.UI"
    xmlns:d="clr-namespace:Microsoft.UI.Xaml.Data;assembly=CodeBrix.Platform.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Fresco.Brix.ViewModels;assembly=Fresco.Brix.Core"
    xmlns:local="using:Fresco.Brix.Views"
    FontFamily="{StaticResource RobotoFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- The menu bar -->
            <RowDefinition Height="Auto" />
            <!-- The document tabs -->
            <RowDefinition Height="Auto" />
            <!-- The dock shell: tool panels around the editor area -->
            <RowDefinition Height="*" />
            <!-- The status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar x:Name="MainMenuBar" Grid.Row="0" />

        <!-- The tab bar and the shell are built in code: the shell's splitters
             and panel hosts are code-built controls (there is no dock
             framework in the platform), and the tabs follow the document list
             rather than an items source. -->
        <ContentControl x:Name="TabBarHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" />

        <ContentControl x:Name="ShellHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- The window's message line. The caret position lives on each
             editor pane's own status bar, as it does upstream, so this stays
             out of the way until there is something to say. -->
        <TextBlock x:Name="StatusLine" Grid.Row="3" Padding="8,4,8,6"
                   Visibility="Collapsed"
                   Text="{d:Binding StatusText}" />
    </Grid>
</Page>

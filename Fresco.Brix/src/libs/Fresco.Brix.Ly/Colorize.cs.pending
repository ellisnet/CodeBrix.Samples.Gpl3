/// <summary>
/// A style assignment within a mapping group — upstream's <c>style</c> named
/// tuple with its three fields: name, base and classes.
/// </summary>
/// <param name="Name">The style name (becomes the mode-specific CSS class).</param>
/// <param name="Base">The base style name the style inherits from, or
/// <see langword="null"/> for none.</param>
/// <param name="Classes">The token classes the style applies to.</param>
public sealed record Style(string Name, string Base, Type[] Classes);

/// <summary>
/// Describes a CSS class for a token — upstream's <c>css_class</c> named tuple
/// with its three fields: mode, name, base. E.g.
/// <c>("lilypond", "articulation", "keyword")</c>. The base field may be
/// <see langword="null"/>. Value equality (the named tuple's) is preserved by
/// the record, which <see cref="Colorize.MeltMappedTokens{TValue}"/> relies on.
/// </summary>
/// <param name="Mode">The mode name (e.g. "lilypond").</param>
/// <param name="Name">The style name within the mode.</param>
/// <param name="Base">The base style name, or <see langword="null"/>.</param>
public sealed record CssClass(string Mode, string Name, string Base);

/// <summary>
/// Maps token classes to arbitrary values, which can be highlighting styles.
/// <para>
/// Mapper behaves like a dict, you set items with a token class as key to an
/// arbitrary value.
/// </para>
/// <para>
/// But getting items can be done using a token. Upstream walks the token
/// class's python method resolution order; here the
/// <see cref="Type.BaseType"/> chain is the C# spelling of that walk (the C#
/// hierarchy keeps python's FIRST base as the base chain), and the value for
/// the first available class found in the keys is returned. The class is also
/// cached to speed up requests for other tokens.
/// </para>
/// </summary>
/// <typeparam name="TValue">The mapped value type; upstream maps to arbitrary
/// values (for CSS highlighting a <see cref="CssClass"/>).</typeparam>
public class Mapper<TValue> : Dictionary<Type, TValue>
    where TValue : class
{
    /// <summary>Initializes an empty mapper.</summary>
    public Mapper()
    {
    }

    /// <summary>Initializes the mapper from class/value pairs; a later pair
    /// with the same class wins, like python's dict construction.</summary>
    /// <param name="items">The class/value pairs.</param>
    public Mapper(IEnumerable<KeyValuePair<Type, TValue>> items)
    {
        foreach (KeyValuePair<Type, TValue> item in items)
        {
            this[item.Key] = item.Value;
        }
    }

    /// <summary>
    /// Gets the value for the token: the token class's base-class chain is
    /// walked up and the value for the first available class found in the keys
    /// is returned, or <see langword="null"/> when none of the ancestry is
    /// mapped. The answer is cached under the token's concrete class.
    /// </summary>
    /// <param name="token">The token to look up.</param>
    public TValue this[Slexing.Token token]
    {
        get
        {
            Type cls = token.GetType();
            if (TryGetValue(cls, out TValue value))
            {
                return value;
            }

            //upstream note: _token_mro_slice — upstream's walk skips the class
            // itself (tried above) and stops before ly.lex.Token.__mro__ (the
            // Token base classes are not tested); stopping the BaseType walk at
            // Lex.Token excludes exactly the same classes here.
            value = null;
            for (Type c = cls.BaseType; c != null && c != typeof(Lex.Token); c = c.BaseType)
            {
                if (TryGetValue(c, out TValue found))
                {
                    value = found;
                    break;
                }
            }

            this[cls] = value;
            return value;
        }
    }
}

/// <summary>
/// Classes and functions to colorize (syntax-highlight) parsed source.
/// <para>
/// Highlighting is based on CSS properties and their values, although the
/// <see cref="Mapper{TValue}"/> object can map a token's class to any object or
/// value.
/// </para>
/// <para>
/// The mapper normally maps a token's class basically to a CSS class and
/// possibly a base CSS class. This way you can define base styles (e.g.
/// string, comment, etc) and have specific classes (e.g. LilyPond string,
/// Scheme comment) inherit from that base style. This CSS class is described
/// by the <see cref="CssClass"/> record, with its three fields: mode, name,
/// base. E.g. <c>("lilypond", "articulation", "keyword")</c>. The base field
/// may be <see langword="null"/>.
/// </para>
/// <para>
/// The css classes are mapped to dictionaries of css properties, like
/// <c>{"font-weight": "bold", "color": "#4800ff"}</c>, etc.
/// </para>
/// <para>
/// A scheme (a collection of styles) is simply a dictionary mapping the mode
/// to a dictionary of CSS dictionaries. The base styles are in the
/// <see cref="BaseStylesKey"/> item of the scheme dictionary.
/// </para>
/// </summary>
public static class Colorize
{
    /// <summary>
    /// The key of the base-styles entry in a scheme dictionary.
    /// </summary>
    //upstream note: upstream keys the base styles under None; a C# string
    // dictionary cannot hold a null key, so the empty string stands in for it —
    // it sorts first and is "falsy" in the same places None is upstream.
    public const string BaseStylesKey = "";

    /// <summary>
    /// Returns a good default mapping from token class(es) to style and
    /// default style, per group.
    /// </summary>
    /// <returns>The (mode, styles) groups, in the upstream order.</returns>
    public static (string Mode, Style[] Styles)[] DefaultMapping()
    {
        //from ly.lex import latex   (commented out upstream)
        //from ly.lex import docbook (commented out upstream)

        return new (string Mode, Style[] Styles)[]
        {
            ("lilypond", new Style[]
            {
                new Style("keyword", "keyword", new Type[] { typeof(LilyPondMode.Keyword) }),
                new Style("command", "function", new Type[] { typeof(LilyPondMode.Command), typeof(LilyPondMode.Skip) }),
                new Style("pitch", null, new Type[] { typeof(LilyPondMode.MusicItem) }),
                new Style("octave", null, new Type[] { typeof(LilyPondMode.Octave) }),
                new Style("accidental", null, new Type[] { typeof(LilyPondMode.Accidental), typeof(LilyPondMode.FigureAccidental) }),
                new Style("duration", null, new Type[] { typeof(LilyPondMode.Duration) }),
                new Style("dynamic", null, new Type[] { typeof(LilyPondMode.Dynamic) }),
                new Style("check", null, new Type[] { typeof(LilyPondMode.OctaveCheck), typeof(LilyPondMode.PipeSymbol) }),
                new Style("articulation", null, new Type[] { typeof(LilyPondMode.Direction), typeof(LilyPondMode.Articulation) }),
                new Style("fingering", null, new Type[] { typeof(LilyPondMode.Fingering) }),
                new Style("stringnumber", null, new Type[] { typeof(LilyPondMode.StringNumber) }),
                new Style("slur", null, new Type[] { typeof(LilyPondMode.Slur) }),
                new Style("beam", null, new Type[] { typeof(LilyPondMode.Beam), typeof(LilyPondMode.FigureBracket) }),
                new Style("chord", null, new Type[] { typeof(LilyPondMode.Chord), typeof(LilyPondMode.ChordItem) }),
                new Style("markup", "function", new Type[] { typeof(LilyPondMode.Markup) }),
                new Style("lyricmode", "function", new Type[] { typeof(LilyPondMode.LyricMode) }),
                new Style("lyrictext", null, new Type[] { typeof(LilyPondMode.Lyric) }),
                new Style("repeat", "function", new Type[] { typeof(LilyPondMode.Repeat), typeof(LilyPondMode.Tremolo) }),
                new Style("specifier", "variable", new Type[] { typeof(LilyPondMode.Specifier) }),
                new Style("usercommand", "variable", new Type[] { typeof(LilyPondMode.UserCommand) }),
                new Style("figbass", null, new Type[] { typeof(LilyPondMode.Figure) }),
                new Style("figbstep", null, new Type[] { typeof(LilyPondMode.FigureStep) }),
                new Style("figbmodif", null, new Type[] { typeof(LilyPondMode.FigureModifier) }),
                new Style("delimiter", "keyword", new Type[] { typeof(LilyPondMode.Delimiter) }),
                new Style("context", null, new Type[] { typeof(LilyPondMode.ContextName) }),
                new Style("grob", null, new Type[] { typeof(LilyPondMode.GrobName) }),
                new Style("property", "variable", new Type[] { typeof(LilyPondMode.ContextProperty) }),
                new Style("variable", "variable", new Type[] { typeof(LilyPondMode.Variable) }),
                new Style("uservariable", null, new Type[] { typeof(LilyPondMode.UserVariable) }),
                new Style("value", "value", new Type[] { typeof(LilyPondMode.Value) }),
                new Style("string", "string", new Type[]
                {
                    typeof(LilyPondMode.StringBase),
                    //upstream note: upstream maps only lilypond.String here; its
                    // StringQuotedStart/StringQuotedEnd subclasses reach the style
                    // through their python FIRST base (String), but their C# base
                    // chain is the Lex.StringStart/Lex.StringEnd side, so they are
                    // mapped explicitly to keep the same resolution.
                    typeof(LilyPondMode.StringQuotedStart),
                    typeof(LilyPondMode.StringQuotedEnd),
                }),
                new Style("stringescape", "escape", new Type[] { typeof(LilyPondMode.StringQuoteEscape) }),
                new Style("comment", "comment", new Type[]
                {
                    typeof(LilyPondMode.Comment),
                    //upstream note: upstream maps only lilypond.Comment here; the
                    // four subclasses reach the style through their python FIRST
                    // base (Comment), but their C# base chain is the Lex.* block
                    // and line comment side, so they are mapped explicitly to keep
                    // the same resolution.
                    typeof(LilyPondMode.BlockCommentStart),
                    typeof(LilyPondMode.BlockCommentEnd),
                    typeof(LilyPondMode.BlockComment),
                    typeof(LilyPondMode.LineComment),
                }),
                new Style("error", "error", new Type[] { typeof(LilyPondMode.Error) }),
            }),
            ("scheme", new Style[]
            {
                new Style("scheme", null, new Type[] { typeof(LilyPondMode.SchemeStart), typeof(SchemeMode.Scheme) }),
                new Style("string", "string", new Type[]
                {
                    typeof(SchemeMode.StringBase),
                    //upstream note: upstream maps only scheme.String here; its
                    // StringQuotedStart/StringQuotedEnd subclasses reach the style
                    // through their python FIRST base (String), but their C# base
                    // chain is the Lex.StringStart/Lex.StringEnd side, so they are
                    // mapped explicitly to keep the same resolution.
                    typeof(SchemeMode.StringQuotedStart),
                    typeof(SchemeMode.StringQuotedEnd),
                }),
                new Style("stringescape", "escape", new Type[] { typeof(SchemeMode.StringQuoteEscape) }),
                new Style("comment", "comment", new Type[]
                {
                    typeof(SchemeMode.Comment),
                    //upstream note: upstream maps only scheme.Comment here; the
                    // four subclasses reach the style through their python FIRST
                    // base (Comment), but their C# base chain is the Lex.* block
                    // and line comment side, so they are mapped explicitly to keep
                    // the same resolution.
                    typeof(SchemeMode.LineComment),
                    typeof(SchemeMode.BlockCommentStart),
                    typeof(SchemeMode.BlockCommentEnd),
                    typeof(SchemeMode.BlockComment),
                }),
                new Style("number", "value", new Type[] { typeof(SchemeMode.Number) }),
                new Style("lilypond", null, new Type[] { typeof(SchemeMode.LilyPond) }),
                new Style("keyword", "keyword", new Type[] { typeof(SchemeMode.Keyword) }),
                new Style("function", "function", new Type[] { typeof(SchemeMode.Function) }),
                new Style("variable", "variable", new Type[] { typeof(SchemeMode.Variable) }),
                new Style("constant", "variable", new Type[] { typeof(SchemeMode.Constant) }),
                new Style("delimiter", null, new Type[] { typeof(SchemeMode.OpenParen), typeof(SchemeMode.CloseParen) }),
            }),
            ("html", new Style[]
            {
                new Style("tag", "keyword", new Type[] { typeof(HtmlMode.Tag) }),
                new Style("attribute", "variable", new Type[] { typeof(HtmlMode.AttrName) }),
                new Style("value", "value", new Type[] { typeof(HtmlMode.Value) }),
                new Style("string", "string", new Type[] { typeof(HtmlMode.StringBase) }),
                new Style("entityref", "escape", new Type[] { typeof(HtmlMode.EntityRef) }),
                new Style("comment", "comment", new Type[] { typeof(HtmlMode.Comment) }),
                new Style("lilypondtag", "function", new Type[] { typeof(HtmlMode.LilyPondTag) }),
            }),
            ("texinfo", new Style[]
            {
                new Style("keyword", "keyword", new Type[] { typeof(TexinfoMode.Keyword) }),
                new Style("block", "function", new Type[] { typeof(TexinfoMode.Block) }),
                new Style("attribute", "variable", new Type[] { typeof(TexinfoMode.Attribute) }),
                new Style("escapechar", "escape", new Type[] { typeof(TexinfoMode.EscapeChar) }),
                new Style("verbatim", "string", new Type[] { typeof(TexinfoMode.Verbatim) }),
                new Style("comment", "comment", new Type[] { typeof(TexinfoMode.Comment) }),
            }),
            ("mup", new Style[]
            {
                new Style("string", "string", new Type[] { typeof(MupMode.StringBase) }),
                new Style("stringescape", "escape", new Type[] { typeof(MupMode.StringQuoteEscape) }),
                new Style("comment", "comment", new Type[] { typeof(MupMode.Comment) }),
                new Style("macro", "variable", new Type[] { typeof(MupMode.Macro) }),
                new Style("preprocessor", "keyword", new Type[] { typeof(MupMode.Preprocessor) }),
            }),
        }; // end of mapping
    }


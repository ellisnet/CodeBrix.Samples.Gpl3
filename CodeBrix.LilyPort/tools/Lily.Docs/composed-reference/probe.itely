{ c'4 d'4 e'4 }
@end lilypond

@node noindent
@section noindent

@lilypond[noindent]
{ d'4 e'4 f'4 g'4 }
@end lilypond

@node papersize
@section papersize

@lilypond[papersize=a6]
{ e'4 }
@end lilypond

@node papersize-line-width

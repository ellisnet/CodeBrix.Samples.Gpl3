<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>Lily.Shell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.231.233" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" Version="1.0.209.315" />
    <!-- Roboto Mono - the terminal surface's monospace font (app chrome stays Roboto) -->
    <PackageReference Include="CodeBrix.Platform.Fonts.RobotoMono.OflLicenseForever" Version="1.0.216.1150" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Lily.Shell.Kernel\Lily.Shell.Kernel.csproj" />
    <ProjectReference Include="..\libs\Lily.Shell.TerminalView\Lily.Shell.TerminalView.csproj" />
  </ItemGroup>

  <!-- The in-process LilyPort engine. The facade nuget packs its sub-assemblies
       with PrivateAssets="all", so an in-repo ProjectReference consumer must
       reference all four projects explicitly (a nuget consumer needs only the
       one CodeBrix.LilyPort.GplLicenseForever package). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\CodeBrix.LilyPort\CodeBrix.LilyPort.csproj" />
    <ProjectReference Include="..\..\..\..\src\CodeBrix.LilyPort.Engine\CodeBrix.LilyPort.Engine.csproj" />
    <ProjectReference Include="..\..\..\..\src\CodeBrix.LilyPort.Backends\CodeBrix.LilyPort.Backends.csproj" />
    <ProjectReference Include="..\..\..\..\src\CodeBrix.LilyPort.Parsing\CodeBrix.LilyPort.Parsing.csproj" />
  </ItemGroup>

  <!-- The Emmentaler faces: the engine's font layer probes <appdir>/fonts/otf.
       CopyToOutputDirectory content flows to every head through the
       ProjectReference chain. -->
  <ItemGroup>
    <None Include="..\..\..\..\assets\fonts\otf\*.otf" Link="fonts\otf\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

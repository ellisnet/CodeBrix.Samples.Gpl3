<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.LilyPort.Flower</AssemblyName>
    <RootNamespace>CodeBrix.LilyPort.Flower</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Bundled into the CodeBrix.LilyPort package rather than published alone. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

<!--
    Package / assembly version: date-stamped and auto-incrementing.
    1.<years-since-2026>.<day-of-year>.<minute-of-day>, all from UTC now, so the
    value is strictly increasing over time. This is date-stamp versioning, not
    SemVer: major/minor do not signal API compatibility.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>
</Project>

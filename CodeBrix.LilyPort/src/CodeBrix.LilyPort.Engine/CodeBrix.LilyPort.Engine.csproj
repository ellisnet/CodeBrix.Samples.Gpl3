<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.LilyPort.Engine</AssemblyName>
    <RootNamespace>CodeBrix.LilyPort.Engine</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scheme\**\*" />
    <!--
      The upstream lily/*.cc ledger. Embedded so the fence test reads the same bytes
      the library ships, and so no test step needs the read-only ~/GitHome/lilypond
      reference tree (standing rule 7).
    -->
    <EmbeddedResource Include="lily-cc-ledger.tsv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.LilyPort.Flower\CodeBrix.LilyPort.Flower.csproj" />
    <!--
      Development-time ProjectReference into the sibling CodeBrix.LilyScheme repo.
      Long-term this becomes a PackageReference on
      CodeBrix.LilyScheme.LgplLicenseForever; see the plan section 1. Flagged
      here because a cross-repo filesystem reference is discouraged-but-negotiable
      under the CodeBrix rules, and this one is deliberate and temporary.
    -->
    <ProjectReference Include="..\..\..\..\CodeBrix.LilyScheme\src\CodeBrix.LilyScheme\CodeBrix.LilyScheme.csproj" />
  </ItemGroup>

</Project>

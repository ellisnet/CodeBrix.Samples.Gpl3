<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.49" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The facade bundles its sub-assemblies with PrivateAssets="all" (the D8 packing
    pattern), so they are deliberately NOT transitive to consumers. First light drives
    the engine directly to build its music and inspect the grobs it produced, so the
    test project references them explicitly. A consumer of the nuget does not need to:
    all four assemblies ship inside the one package.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort\CodeBrix.LilyPort.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort.Engine\CodeBrix.LilyPort.Engine.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort.Backends\CodeBrix.LilyPort.Backends.csproj" />
  </ItemGroup>

  <!--
    First light engraves real music, so it needs a real Emmentaler to measure and to
    name glyphs from. These are the fonts this repo builds and ships from its own
    vendored mf/ sources, so this is an in-repo fixture, not an external dependency.
    AllFontMetrics probes a TestFonts folder beside the assembly.
  -->
  <ItemGroup>
    <None Include="..\..\assets\fonts\otf\emmentaler-20.otf"
          Link="TestFonts\emmentaler-20.otf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\otf\emmentaler-brace.otf"
          Link="TestFonts\emmentaler-brace.otf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
